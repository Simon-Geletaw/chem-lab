{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "axe-core": {
      "type": "local",
      "command": ["npx", "-y", "@axe-core/mcp"],
      "enabled": true
    }
  }
}
